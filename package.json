{
  "name": "daily-diet-api",
  "version": "0.0.1",
  "description": "API para registro e acompanhamento da dieta de um ou mais usuários",
  "main": "server.js",
  "scripts": {
    "build": "tsup src",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "knex": "node --no-warnings --loader tsx ./node_modules/knex/bin/cli.js"
  },
  "engines": {
    "node": ">= 18.0.0 <= 18.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/layonendlich/rs-desafio-2-daily-diet-api.git"
  },
  "keywords": [
    "Desafio",
    "RocketSeat",
    "Node.js",
    "Typescript"
  ],
  "author": "Layon Endlich Rodrigues",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/layonendlich/rs-desafio-2-daily-diet-api/issues"
  },
  "homepage": "https://github.com/layonendlich",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "sqlite3": "^5.1.4",
    "tsup": "^8.5.1",
    "tsx": "^3.12.2",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "@fastify/cookie": "^8.3.0",
    "argon2": "^0.44.0",
    "dotenv": "^16.6.1",
    "fastify": "^4.12.0",
    "knex": "^2.4.2",
    "mysql2": "^3.20.0",
    "pg": "^8.21.0",
    "zod": "^3.20.2"
  }
}
